{
  "name": "bid-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:auth": "npm run test:e2e:auth:frontend && npm run test:e2e:auth:active",
    "test:e2e:auth:active": "playwright test --config=playwright.auth-active.config.ts",
    "test:e2e:auth:frontend": "playwright test e2e/auth-session.e2e.ts --config=playwright.config.ts",
    "test:e2e:hidden": "playwright test e2e/billing-hidden.e2e.ts --config=playwright.config.ts",
    "test:e2e:court": "playwright test e2e/court-search.e2e.ts --config=playwright.sidebar.config.ts",
    "test:e2e:inquiries": "playwright test --config=playwright.inquiries.config.ts",
    "test:e2e:kakao": "playwright test --config=playwright.kakao.config.ts",
    "test:e2e:legal": "playwright test --config=playwright.legal.config.ts",
    "test:e2e:map": "playwright test --config=playwright.map.config.ts",
    "test:e2e:npl": "playwright test --config=playwright.npl.config.ts",
    "test:e2e:performance": "playwright test --config=playwright.performance.config.ts",
    "test:e2e:schedule": "playwright test e2e/schedule-calendar.e2e.ts --config=playwright.sidebar.config.ts",
    "test:e2e:search": "playwright test --config=playwright.search.config.ts",
    "test:e2e:search-options": "playwright test --config=playwright.search-options.config.ts",
    "test:e2e:sidebar": "playwright test e2e/sidebar-menu.e2e.ts --config=playwright.sidebar.config.ts",
    "test:e2e:subway": "playwright test --config=playwright.subway.config.ts",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:auth:active && npm run test:e2e:search && npm run test:e2e:search-options && npm run test:e2e:sidebar && npm run test:e2e:court && npm run test:e2e:schedule && npm run test:e2e:legal && npm run test:e2e:inquiries && npm run test:e2e:kakao && npm run test:e2e:map && npm run test:e2e:subway && npm run test:e2e:npl && npm run test:e2e:performance",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "validate:forms": "node scripts/validate-knowledge-forms.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.10"
  }
}
